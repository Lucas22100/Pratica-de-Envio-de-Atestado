	if (current.birth_date){

		var birth = new GlideDateTime(current.birth_date);
		var today = new GlideDateTime();
		
		var age = today.getYearLocalTime() - birth.getYearLocalTime();

		if (
			today.getMonthLocalTime() < birth.getMonthLocalTime() || 
			(today.getMonthLocalTime() == birth.getMonthLocalTime() && today.getDayOfMonthLocalTime() < birth.getDayOfMonthLocalTime())
			){
				age--;
			}
			current.age = age;
	}

})(current, previous);]]></script>
